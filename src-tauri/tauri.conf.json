{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Usage",
  "version": "0.1.0",
  "identifier": "com.aiusage.menubar",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": { "macOSPrivateApi": true, "windows": [{ "title": "AI Usage", "width": 310, "height": 480, "resizable": false, "center": false, "decorations": false, "shadow": true, "transparent": true, "backgroundColor": "#00000000", "alwaysOnTop": true, "skipTaskbar": true, "visible": false, "backgroundThrottling": "disabled" }] },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"], "macOS": { "minimumSystemVersion": "13.0" } }
}
